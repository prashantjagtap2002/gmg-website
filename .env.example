# Careers (/careers) — reads open roles from and writes applications to the
# same Supabase project as the GMG Careers admin CRM (C:\careers-app).
# Server-side only: never prefix these with NEXT_PUBLIC_. The service_role key
# bypasses Row Level Security.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the "gmg-website" R2 bucket that holds a copy of public/media,
# e.g. https://media.gautammodigroup.com. Leave blank to serve /media locally.
# Use a custom domain, not the rate-limited, uncached pub-*.r2.dev URL.
NEXT_PUBLIC_MEDIA_BASE=

# Cloudflare Worker that stores resume files (see careers-app/worker).
# Leave blank to hide the resume upload field. Both ship in the browser bundle.
NEXT_PUBLIC_RESUME_WORKER_URL=
NEXT_PUBLIC_RESUME_ACCESS_TOKEN=
